<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- read the Victoria 2 folder chosen by the user by file path
         (C++ uses open/mmap); the user grants it in Settings -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- multiplayer -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- GLES 3.2 (the game uses draw indirect and multisample textures) -->
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />

    <!-- AliceActivity (NativeActivity) loads libAlice.so and calls android_main;
         Java only handles permission, folder picker and messages -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name=".AliceActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|density|uiMode">

            <meta-data android:name="android.app.lib_name" android:value="Alice" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
