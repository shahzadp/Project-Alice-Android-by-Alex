<svg 
	xmlns = "http://www.w3.org/2000/svg"
	viewBox = "0 0 [[W;1000;0]] [[H;1000;0]] " 
	width = "[[W;1000;0]]" 
	height = "[[H;1000;0]]" >  

	<!-- Victoria II style inset frame: two offset dark rules, no fill, so it can
	     be layered over a panel without hiding what is inside.

	     Offsets are asvg units: 62.5 units = 1 px on the standard 8 px grid. -->

	<rect x="[[P;1;0]]" y="[[P;1;0]]" width="[[W;1000;-125]]" height="[[H;1000;-125]]" fill="none" stroke="#3b2f22" stroke-width="[[P;1;0]]" />
	<rect x="[[P;2.5;0]]" y="[[P;2.5;0]]" width="[[W;1000;-312.5]]" height="[[H;1000;-312.5]]" fill="none" stroke="#8d7a58" stroke-width="[[P;1;0]]" stroke-opacity="0.8" />
</svg>
