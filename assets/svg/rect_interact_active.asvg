<svg 
	xmlns = "http://www.w3.org/2000/svg"
	viewBox = "0 0 [[W;1000;0]] [[H;1000;0]] " 
	width = "[[W;1000;0]]" 
	height = "[[H;1000;0]]" >  

	<!-- Victoria II style button, pressed/hovered state: the same tan face, but
	     sunk (dark top edge) and warmed towards gold.

	     Offsets are asvg units: 62.5 units = 1 px on the standard 8 px grid. -->

	<defs>
		<linearGradient id="btnface_on" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#b3a684" />
			<stop offset="0.5" stop-color="#d5c69c" />
			<stop offset="1" stop-color="#e6d9b2" />
		</linearGradient>
	</defs>

	<rect x="0" y="0" width="[[W;1000;0]]" height="[[H;1000;0]]" fill="#2f2519" />
	<rect x="[[P;1;0]]" y="[[P;1;0]]" width="[[W;1000;-125]]" height="[[H;1000;-125]]" fill="url(#btnface_on)" />
	<rect x="[[P;1;0]]" y="[[P;1;0]]" width="[[W;1000;-125]]" height="[[P;1;0]]" fill="#7a6b4c" fill-opacity="0.6" />
	<rect x="[[P;1;0]]" y="[[H;1000;-125]]" width="[[W;1000;-125]]" height="[[P;1;0]]" fill="#fff6dd" fill-opacity="0.45" />
	<rect x="[[P;1.5;0]]" y="[[P;1.5;0]]" width="[[W;1000;-187.5]]" height="[[H;1000;-187.5]]" fill="none" stroke="#b09a68" stroke-width="[[P;1;0]]" />
</svg>
