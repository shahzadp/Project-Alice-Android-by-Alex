<svg 
	xmlns = "http://www.w3.org/2000/svg"
	viewBox = "0 0 [[W;1000;0]] [[H;1000;0]] " 
	width = "[[W;1000;0]]" 
	height = "[[H;1000;0]]" >  

	<!-- Victoria II style list selection: pale parchment row with a gold bar down
	     the left edge.

	     Offsets are asvg units: 62.5 units = 1 px on the standard 8 px grid. -->

	<rect x="0" y="0" width="[[W;1000;0]]" height="[[H;1000;0]]" fill="#e7dfc8" />
	<rect x="0" y="0" width="[[P;3;0]]" height="[[H;1000;0]]" fill="#b09a68" />
	<rect x="0" y="[[H;1000;-62.5]]" width="[[W;1000;0]]" height="[[P;1;0]]" fill="#a89d84" fill-opacity="0.5" />
</svg>
