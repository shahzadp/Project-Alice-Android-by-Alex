<svg 
	xmlns = "http://www.w3.org/2000/svg"
	viewBox = "0 0 [[W;1000;0]] [[H;1000;0]] " 
	width = "[[W;1000;0]]" 
	height = "[[H;1000;0]]" >  

	<!-- Victoria II style toggle, off state: parchment button face with an empty
	     dark-ringed marker on the left.

	     Offsets are asvg units: 62.5 units = 1 px on the standard 8 px grid. -->

	<defs>
		<linearGradient id="toggleoff" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#d2c8ab" />
			<stop offset="1" stop-color="#bfb393" />
		</linearGradient>
	</defs>

	<rect x="0" y="0" width="[[W;1000;0]]" height="[[H;1000;0]]" fill="url(#toggleoff)" />
	<rect x="[[P;0.5;0]]" y="[[P;0.5;0]]" width="[[W;1000;-62.5]]" height="[[H;1000;-62.5]]" fill="none" stroke="#4a3b2a" stroke-width="[[P;1;0]]" />
	<circle cx="[[H;450;0]]" cy="[[H;500;0]]" r="[[H;270;0]]" fill="#efe8d6" stroke="#4a3b2a" stroke-width="[[P;1;0]]" />
</svg>
