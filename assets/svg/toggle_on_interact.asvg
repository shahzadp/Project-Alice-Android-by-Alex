<svg 
	xmlns = "http://www.w3.org/2000/svg"
	viewBox = "0 0 [[W;1000;0]] [[H;1000;0]] " 
	width = "[[W;1000;0]]" 
	height = "[[H;1000;0]]" >  

	<!-- Victoria II style toggle, on state: warm button face with a filled
	     maroon marker ringed in gold on the left.

	     Offsets are asvg units: 62.5 units = 1 px on the standard 8 px grid. -->

	<defs>
		<linearGradient id="toggleon" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#e3d7b4" />
			<stop offset="1" stop-color="#cdbe97" />
		</linearGradient>
	</defs>

	<rect x="0" y="0" width="[[W;1000;0]]" height="[[H;1000;0]]" fill="url(#toggleon)" />
	<rect x="[[P;0.5;0]]" y="[[P;0.5;0]]" width="[[W;1000;-62.5]]" height="[[H;1000;-62.5]]" fill="none" stroke="#4a2230" stroke-width="[[P;1;0]]" />
	<circle cx="[[H;450;0]]" cy="[[H;500;0]]" r="[[H;270;0]]" fill="#4a2230" stroke="#b09a63" stroke-width="[[P;1;0]]" />
	<circle cx="[[H;450;0]]" cy="[[H;500;0]]" r="[[H;120;0]]" fill="#efe8d6" />
</svg>
