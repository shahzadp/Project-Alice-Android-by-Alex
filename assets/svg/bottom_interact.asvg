<svg 
	xmlns = "http://www.w3.org/2000/svg"
	viewBox = "0 0 [[W;1000;0]] [[H;1000;0]] " 
	width = "[[W;1000;0]]" 
	height = "[[H;1000;0]]" >  

	<!-- Victoria II style table column header: maroon banner fading downwards,
	     with a gold rule along the bottom edge.

	     Offsets are asvg units: 62.5 units = 1 px on the standard 8 px grid. -->

	<defs>
		<linearGradient id="headerfade" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#4a2230" stop-opacity="1" />
			<stop offset="0.65" stop-color="#4a2230" stop-opacity="0.85" />
			<stop offset="1" stop-color="#33161f" stop-opacity="0.25" />
		</linearGradient>
	</defs>

	<rect x="0" y="0" width="[[W;1000;0]]" height="[[H;1000;0]]" fill="url(#headerfade)" />
	<rect x="0" y="[[H;1000;-62.5]]" width="[[W;1000;0]]" height="[[P;1;0]]" fill="#b39a63" fill-opacity="0.85" />
</svg>
