<svg 
	xmlns = "http://www.w3.org/2000/svg"
	viewBox = "0 0 [[W;1000;0]] [[H;1000;0]] " 
	width = "[[W;1000;0]]" 
	height = "[[H;1000;0]]" >  

	<!-- Victoria II style popup / tooltip: cream parchment with a dark bevelled
	     edge and a gold hairline. Used by the "popup window" template.

	     Offsets are asvg units: 62.5 units = 1 px on the standard 8 px grid. -->

	<defs>
		<linearGradient id="popupbody" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#f2ecdc" />
			<stop offset="1" stop-color="#e2dbc8" />
		</linearGradient>
	</defs>

	<rect x="0" y="0" width="[[W;1000;0]]" height="[[H;1000;0]]" fill="#2f2519" />
	<rect x="[[P;1;0]]" y="[[P;1;0]]" width="[[W;1000;-125]]" height="[[H;1000;-125]]" fill="url(#popupbody)" />
	<rect x="[[P;2;0]]" y="[[P;2;0]]" width="[[W;1000;-250]]" height="[[H;1000;-250]]" fill="none" stroke="#b09a68" stroke-width="[[P;1;0]]" stroke-opacity="0.7" />
</svg>
