<svg 
	xmlns = "http://www.w3.org/2000/svg"
	viewBox = "0 0 [[W;1000;0]] [[H;1000;0]] " 
	width = "[[W;1000;0]]" 
	height = "[[H;1000;0]]" >  

	<!-- Victoria II style window frame: near-black bevelled frame around a
	     parchment body with the double gold/brown rule Vic2 windows use.

	     asvg units: the axis tokens resolve to 500 * size / base, so 1 unit is
	     500 / grid_size pixels (62.5 on the 8 px grid every window uses).
	     Offsets therefore have to be written in those units: -62.5 = 1 px. -->

	<defs>
		<linearGradient id="frameedge" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#6b573c" />
			<stop offset="0.5" stop-color="#4a3a28" />
			<stop offset="1" stop-color="#33271b" />
		</linearGradient>
		<linearGradient id="bodyfill" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#e3ddcf" />
			<stop offset="0.55" stop-color="#d5cebf" />
			<stop offset="1" stop-color="#c3bcaa" />
		</linearGradient>
	</defs>

	<rect x="0" y="0" width="[[W;1000;0]]" height="[[H;1000;0]]" fill="#241c15" />
	<rect x="[[P;1;0]]" y="[[P;1;0]]" width="[[W;1000;-125]]" height="[[H;1000;-125]]" fill="url(#frameedge)" />
	<rect x="[[P;4;0]]" y="[[P;4;0]]" width="[[W;1000;-500]]" height="[[H;1000;-500]]" fill="url(#bodyfill)" />
	<rect x="[[P;4;0]]" y="[[P;4;0]]" width="[[W;1000;-500]]" height="[[H;1000;-500]]" fill="none" stroke="#b09a68" stroke-width="[[P;1;0]]" />
	<rect x="[[P;6;0]]" y="[[P;6;0]]" width="[[W;1000;-750]]" height="[[H;1000;-750]]" fill="none" stroke="#7d6a4a" stroke-width="[[P;1;0]]" stroke-opacity="0.55" />
</svg>
