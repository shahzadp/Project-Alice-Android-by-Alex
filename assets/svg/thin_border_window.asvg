<svg 
	xmlns = "http://www.w3.org/2000/svg"
	viewBox = "0 0 [[W;1000;0]] [[H;1000;0]] " 
	width = "[[W;1000;0]]" 
	height = "[[H;1000;0]]" >  

	<!-- Victoria II style thin window: parchment body with the single dark rule
	     Vic2 uses for secondary windows (the "thin outline window" template).

	     Offsets are asvg units: 62.5 units = 1 px on the standard 8 px grid. -->

	<defs>
		<linearGradient id="thinbody" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#ded8ca" />
			<stop offset="1" stop-color="#cec7b7" />
		</linearGradient>
	</defs>

	<rect x="0" y="0" width="[[W;1000;0]]" height="[[H;1000;0]]" fill="url(#thinbody)" />
	<rect x="0" y="0" width="[[W;1000;-62.5]]" height="[[H;1000;-62.5]]" fill="none" stroke="#4a3b2a" stroke-width="[[P;1;0]]" />
	<rect x="[[P;2;0]]" y="[[P;2;0]]" width="[[W;1000;-250]]" height="[[H;1000;-250]]" fill="none" stroke="#b09a68" stroke-width="[[P;1;0]]" stroke-opacity="0.5" />
</svg>
