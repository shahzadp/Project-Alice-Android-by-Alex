<svg 
	xmlns = "http://www.w3.org/2000/svg"
	viewBox = "0 0 [[W;1000;0]] [[H;1000;0]] " 
	width = "[[W;1000;0]]" 
	height = "[[H;1000;0]]" >  

	<!-- Victoria II style button: tan parchment face, dark bevelled edge and a
	     light top highlight. Used by the "primary button" and "large button"
	     templates.

	     Offsets are asvg units: 62.5 units = 1 px on the standard 8 px grid. -->

	<defs>
		<linearGradient id="btnface" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#d9cdb0" />
			<stop offset="0.5" stop-color="#c8bb9a" />
			<stop offset="1" stop-color="#b3a684" />
		</linearGradient>
	</defs>

	<rect x="0" y="0" width="[[W;1000;0]]" height="[[H;1000;0]]" fill="#2f2519" />
	<rect x="[[P;1;0]]" y="[[P;1;0]]" width="[[W;1000;-125]]" height="[[H;1000;-125]]" fill="url(#btnface)" />
	<rect x="[[P;1;0]]" y="[[P;1;0]]" width="[[W;1000;-125]]" height="[[P;1;0]]" fill="#f0e7cf" fill-opacity="0.5" />
	<rect x="[[P;1;0]]" y="[[H;1000;-125]]" width="[[W;1000;-125]]" height="[[P;1;0]]" fill="#8a7c5c" fill-opacity="0.7" />
</svg>
