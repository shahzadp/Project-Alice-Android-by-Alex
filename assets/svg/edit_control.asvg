<svg 
	xmlns = "http://www.w3.org/2000/svg"
	viewBox = "0 0 [[W;1000;0]] [[H;1000;0]] " 
	width = "[[W;1000;0]]" 
	height = "[[H;1000;0]]" >  

	<!-- Victoria II style text field: recessed cream face with a dark inset
	     border.

	     Offsets are asvg units: 62.5 units = 1 px on the standard 8 px grid. -->

	<rect x="0" y="0" width="[[W;1000;0]]" height="[[H;1000;0]]" fill="#efe9d8" />
	<rect x="[[P;0.5;0]]" y="[[P;0.5;0]]" width="[[W;1000;-62.5]]" height="[[H;1000;-62.5]]" fill="none" stroke="#4a3b2a" stroke-width="[[P;1;0]]" />
	<rect x="[[P;0.5;0]]" y="[[P;0.5;0]]" width="[[W;1000;-62.5]]" height="[[P;1;0]]" fill="#a89d84" fill-opacity="0.6" />
</svg>
